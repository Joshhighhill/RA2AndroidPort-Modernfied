if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 27 80
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 24 and pos_x(0,ZEP) <= 30 and pos_y(0,ZEP) >= 77 and pos_y(0,ZEP) <= 83
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 16 64
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 13 and pos_x(0,ZEP) <= 19 and pos_y(0,ZEP) >= 61 and pos_y(0,ZEP) <= 67
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 25 50
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 22 and pos_x(0,ZEP) <= 28 and pos_y(0,ZEP) >= 47 and pos_y(0,ZEP) <= 53
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 37 40
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 34 and pos_x(0,ZEP) <= 40 and pos_y(0,ZEP) >= 37 and pos_y(0,ZEP) <= 43
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click building 3:CARUS03
wait 30
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 300 outcome != RUNNING
if outcome == RUNNING and units(0,ZEP) > 0 and selected == 0 then click unit 0:ZEP:0 -4 -4
if outcome == RUNNING and selected_type(ZEP) > 0 then click building 3:CARUS03
until 3000 outcome == WON
end expect WON
