# P5: SOV11 (Moscow) won with real orders only (no cheats). 'Yuri Defeated'
# (the Kremlin CARUS03's tag) is the win. Once battle control is online the
# sidebar builds power / refinery / barracks / war factory / radar / battle
# lab and two more Kirov airships join the map's two. All four are selected
# (a click on an airship, T T) and flown by move orders along the cheapest
# line through the flak belts -- past BadGuy1's south-west corner, up the
# western map edge, east onto the Kremlin -- and ordered to attack it; their
# bombs (BlimpHE, 50% vs concrete) bring the 800-HP Kremlin down.
set render_every 3000
set on_quit continue
set campaign sov11s.MAP Nod
until 60 scene == campaign-load
click start
until 300 scene == game
until 900 built(0,NACNST) >= 1
until 900 input_locked == 0
dump
let n_NAPOWR = built(0,NAPOWR)
until 900 can_build(NAPOWR) == 1
click tab:0
wait 2
cycle cameo:NAPOWR queue(structure) == NAPOWR
until 2400 queue_ready(structure) == 1
click cameo:NAPOWR
place auto
until 600 built(0,NAPOWR) > $n_NAPOWR
let n_NAREFN = built(0,NAREFN)
until 900 can_build(NAREFN) == 1
click tab:0
wait 2
cycle cameo:NAREFN queue(structure) == NAREFN
until 2400 queue_ready(structure) == 1
click cameo:NAREFN
place auto
until 600 built(0,NAREFN) > $n_NAREFN
let n_NAHAND = built(0,NAHAND)
until 900 can_build(NAHAND) == 1
click tab:0
wait 2
cycle cameo:NAHAND queue(structure) == NAHAND
until 2400 queue_ready(structure) == 1
click cameo:NAHAND
place auto
until 600 built(0,NAHAND) > $n_NAHAND
let n_NAWEAP = built(0,NAWEAP)
until 900 can_build(NAWEAP) == 1
click tab:0
wait 2
cycle cameo:NAWEAP queue(structure) == NAWEAP
until 2400 queue_ready(structure) == 1
click cameo:NAWEAP
place auto
until 600 built(0,NAWEAP) > $n_NAWEAP
let n_NARADR = built(0,NARADR)
until 900 can_build(NARADR) == 1
click tab:0
wait 2
cycle cameo:NARADR queue(structure) == NARADR
until 2400 queue_ready(structure) == 1
click cameo:NARADR
place auto
until 600 built(0,NARADR) > $n_NARADR
let n_NAPOWR = built(0,NAPOWR)
until 900 can_build(NAPOWR) == 1
click tab:0
wait 2
cycle cameo:NAPOWR queue(structure) == NAPOWR
until 2400 queue_ready(structure) == 1
click cameo:NAPOWR
place auto
until 600 built(0,NAPOWR) > $n_NAPOWR
let n_NATECH = built(0,NATECH)
until 900 can_build(NATECH) == 1
click tab:0
wait 2
cycle cameo:NATECH queue(structure) == NATECH
until 2400 queue_ready(structure) == 1
click cameo:NATECH
place auto
until 600 built(0,NATECH) > $n_NATECH
click tab:3
until 900 cameo(ZEP) == 1 and tab == 3
wait 2
until 3000 queue(vehicle) == "" or queue(vehicle) == ZEP
cycle cameo:ZEP queue(vehicle) == ZEP
until 4000 units(0,ZEP) >= 3 or credits < 100
until 3000 queue(vehicle) == "" or queue(vehicle) == ZEP
cycle cameo:ZEP queue(vehicle) == ZEP
until 4000 units(0,ZEP) >= 4 or credits < 100
dump
click unit 0:ZEP:0 -4 -4
key t
key t
assert selected_type(ZEP) >= 4
click cell 100 148
wait 30
until 2000 pos_x(0,ZEP) >= 97 and pos_x(0,ZEP) <= 103 and pos_y(0,ZEP) >= 145 and pos_y(0,ZEP) <= 151
wait 200
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 86 138
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 83 and pos_x(0,ZEP) <= 89 and pos_y(0,ZEP) >= 135 and pos_y(0,ZEP) <= 141
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
