# P2: SOV09 played with real orders only (no cheats). Generated by
# scripts/play/gen/mk_sov09.py -- edit the generator, not this file.
# Opening (W4-SQ): the Yuris arrive by paradrop plane and are pulled back at
# battle control (65 s) so 'Yuri's are Dead' (armed at 100 s) never fires.
# Then: Yuri 1 takes the IFV patrol, Yuri 0 takes the British engineer from
# the west (it captures the Alliance barracks), two dogs clear the door GIs,
# and Yuri 0 takes the power-plant SEAL, whose C4 blacks out one of the five
# American power plants (output 1000 -> 800).
set render_every 900
set on_quit continue
set campaign sov09u.MAP Nod
until 60 scene == campaign-load
click start
until 300 scene == game
until 600 airborne(6) >= 1
until 2000 campaign_frame >= 980
click unit 6:YURI:0
click cell 36 74
click unit 6:YURI:1
click cell 37 74
until 600 campaign_frame >= 1150
click unit 6:YURI:0
click cell 36 75
click unit 6:YURI:1
click cell 37 75
until 1500 ucy(1,FV,1) >= 70
click xy 500 400 right
click unit 6:YURI:1
click cell 39 77
wait 20
click xy 500 400 right
click unit 6:YURI:1
click unit 1:FV:1
until 300 units(6,FV) >= 1
click xy 500 400 right
click unit 6:FV:0
click cell 27 64
click xy 500 400 right
click unit 6:YURI:1
click cell 26 68
assert units(6,FV) >= 1
assert units(6,YURI) >= 2
click xy 500 400 right
click unit 6:YURI:0
click cell 26 74
wait 20
until 1500 umov(6,YURI,0) == 0
click xy 500 400 right
click unit 6:YURI:0
click cell 25 47
wait 20
until 1500 umov(6,YURI,0) == 0
click xy 500 400 right
click unit 6:YURI:0
click unit 5:SENGINEER:0
until 900 units(6,SENGINEER) >= 1
click xy 500 400 right
click unit 6:SENGINEER:0
click building 2:GAPILE:0
click xy 500 400 right
click unit 6:YURI:0
click cell 25 66
until 900 buildings(0,GAPILE) >= 1
until 900 can_build(DOG) == 1
click tab:2
click cameo:DOG
click cameo:DOG
until 900 units(0,DOG) >= 2
until 900 units(2,E1) <= 5
assert buildings(0,GAPILE) >= 1
assert units(2,E1) <= 5
dump
shot barracks
click xy 500 400 right
click unit 6:YURI:0
click cell 27 43
wait 20
until 2500 umov(6,YURI,0) == 0
click xy 500 400 right
click unit 6:YURI:0
click cell 40 37
wait 20
until 2500 umov(6,YURI,0) == 0
click xy 500 400 right
click unit 6:YURI:0
click cell 63 41
wait 20
until 2500 umov(6,YURI,0) == 0
click xy 500 400 right
click unit 6:YURI:0
click cell 64 39
wait 20
until 2500 umov(6,YURI,0) == 0
until 3000 ucx(1,DOG,5) >= 71 and ucx(1,DOG,6) >= 71 and ucx(1,GHOST,11) >= 63 and ucx(1,GHOST,11) <= 66
click xy 500 400 right
click unit 6:YURI:0
click unit 1:GHOST:11
until 300 units(6,GHOST) >= 1
click xy 500 400 right
click unit 6:GHOST:0
click cell 65 52
click xy 500 400 right
click unit 6:YURI:0
click cell 64 37
wait 20
until 2500 umov(6,YURI,0) == 0
until 900 power_out(1) <= 800
assert power_out(1) <= 800
assert units(6,YURI) >= 2
assert outcome == RUNNING
dump
shot blackout1
end expect RUNNING
