if units(2,E1) > 5 and units(0,DOG) < 2 and queue_stage(infantry) == 0 then click cameo:DOG
wait 300
if units(2,E1) > 5 and units(0,DOG) < 2 and queue_stage(infantry) == 0 then click tab:2
if units(2,E1) > 5 and units(0,DOG) < 2 and queue_stage(infantry) == 0 then click cameo:DOG
wait 300
