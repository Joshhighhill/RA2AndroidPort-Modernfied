# P5: SOV12 (the Allied Chronosphere) won with real orders only (no
# cheats). 'Win Condition_Timer' (the Chronosphere's tag) is the win. The
# sidebar builds power / refinery / war factory / battle lab and Kirov
# airships; the first flies the patriot-free line along the north coast to the
# civilian airfield, where the player discovers the three captured Kirovs
# ('Kirovs Gained' hands them over); the rest follow while the Allied chrono
# raids level the island base. The gathered airships are then flown down the
# western edge of the mainland onto the Chronosphere and ordered to attack it;
# their bombs (BlimpHE, 50% vs concrete) bring the 750-HP Chronosphere down.
set render_every 3000
set on_quit continue
# W6 fix #2: Easy. Since W6-02-11 idle units engage at weapon range + 1 (not Sight)
# and W6-02-16 enemy teams set out at full strength; on Normal the defence no longer
# holds. On Easy the player reloads x0.8 and every computer house x1.2 (W6-02-01..03).
set campaign sov12s.MAP Nod 0
until 60 scene == campaign-load
click start
until 300 scene == game
wait 30
dump
let n_NAPOWR = built(0,NAPOWR)
until 900 can_build(NAPOWR) == 1
click tab:0
wait 2
cycle cameo:NAPOWR queue(structure) == NAPOWR
until 2400 queue_ready(structure) == 1
click cameo:NAPOWR
place auto
until 600 built(0,NAPOWR) > $n_NAPOWR
let n_NAREFN = built(0,NAREFN)
until 900 can_build(NAREFN) == 1
click tab:0
wait 2
cycle cameo:NAREFN queue(structure) == NAREFN
until 2400 queue_ready(structure) == 1
click cameo:NAREFN
place auto
until 600 built(0,NAREFN) > $n_NAREFN
let n_NAWEAP = built(0,NAWEAP)
until 900 can_build(NAWEAP) == 1
click tab:0
wait 2
cycle cameo:NAWEAP queue(structure) == NAWEAP
until 2400 queue_ready(structure) == 1
click cameo:NAWEAP
place auto
until 600 built(0,NAWEAP) > $n_NAWEAP
let n_NAPOWR = built(0,NAPOWR)
until 900 can_build(NAPOWR) == 1
click tab:0
wait 2
cycle cameo:NAPOWR queue(structure) == NAPOWR
until 2400 queue_ready(structure) == 1
click cameo:NAPOWR
place auto
until 600 built(0,NAPOWR) > $n_NAPOWR
let n_NATECH = built(0,NATECH)
until 900 can_build(NATECH) == 1
click tab:0
wait 2
cycle cameo:NATECH queue(structure) == NATECH
until 2400 queue_ready(structure) == 1
click cameo:NATECH
place auto
until 600 built(0,NATECH) > $n_NATECH
click tab:3
until 900 cameo(ZEP) == 1 and tab == 3
wait 2
cycle cameo:ZEP queue(vehicle) == ZEP
click cameo:ZEP
until 4000 units(0,ZEP) >= 1
until 2400 units(0,ZEP) >= 2 or buildings(0,NAWEAP) == 0
wait 60
click unit 0:ZEP:0
if selected_type(ZEP) == 0 then click unit 0:ZEP:0 -2 -2
if selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
assert selected_type(ZEP) >= 1
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
click cell 161 102
wait 30
until 3000 units(0,ZEP) == 0 or pos_x(0,ZEP) >= 157 and pos_x(0,ZEP) <= 165 and pos_y(0,ZEP) >= 98 and pos_y(0,ZEP) <= 106
if units(0,ZEP) > 0 and selected_type(ZEP) == 0 then click unit 0:ZEP:0 -4 -4
key t
key t
