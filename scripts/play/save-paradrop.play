# save-paradrop.play -- W8-06-01 (+ W8-05-07): a skirmish saved while the
# American paratroopers are in the air (the plane still over the site, some
# troopers under their chutes) loads, and every trooper lands. Before the fix
# the load was refused ("unit N unit reference", banner "Error loading game!").
set render_every 3000
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click start
until 90 scene == game
require scene == game
assert side(0) == ALLIED
click unit 0:AMCV
key d
until 600 built(0,GACNST) == 1
cheat w2 build GAPOWR
cheat w2 build GAPOWR
cheat w2 build AMRADR
wait 5
assert sw_has(0,AmerParaDrop) == 1
until 4000 sw_ready_t(0,AmerParaDrop) == 1
let gis = units(0,E1)
click sw:AmerParaDrop
click building 0:GACNST +6 +6
until 600 carried(0) >= 2                                 @W8-06-01
log PARA-IN-AIR
key f10
wait 2
click "menu:SAVE GAME"
wait 2
click dialog:action
wait 5
assert banner == "Mission Saved"                          @W8-06-01
key f10
wait 2
click "menu:LOAD GAME"
wait 2
click dialog:row0
click dialog:action
wait 5
require scene == game                                     @W8-06-01
assert banner == "GAME LOADED"                            @W8-06-01
assert carried(0) >= 1                                    @W8-06-01 # still under the chutes / aboard
until 1500 carried(0) == 0                                @W8-06-01
assert units(0,E1) == $gis+8                              @W8-06-01 @W8-05-07
wait 60
log STILL-RUNNING
end
