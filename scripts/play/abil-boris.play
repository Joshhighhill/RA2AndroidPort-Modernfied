# Wave-5 R-046: Boris designates an enemy building with his Flare (Range 12)
# and calls an airstrike: AirstrikeTeam=2 BPLN MiGs fly in from the map edge,
# fire their Maverick3 and fly out; recharge AirstrikeRechargeTime=100 frames.
set render_every 900
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click combo:ai1
click "pick:Easy Enemy"
click start
until 120 scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
cheat place NAPOWR 1 building 0:GACNST -16 -8
cheat spawn BORIS 0 building 0:GACNST -7 -6
wait 2
let h0 = bhp(1,NAPOWR)
click unit 0:BORIS
click building 1:NAPOWR
until 400 airstrikes >= 1 @R-046:C
assert units(0,BPLN) >= 2 @R-046:C
wait 6
shot boris_migs
until 900 bhp(1,NAPOWR) <= $h0-100 @R-046:C
shot boris_airstrike
end
