# W2-UI HUD tour: sidebar palette, cameo clock / Ready / On Hold / count /
# darken, cameo tooltip, selection pips. Shots under <out>/.
set on_quit continue
set render_every 300
require scene == "shell:Main Menu"
click button "Single Player"
click button Skirmish
require scene == lobby
click start
until 90 scene == game
require scene == game
wait 5
shot h01_start
click unit 0:AMCV
wait 2
shot h02_mcv_selected
key d
until 450 built(0,GACNST) == 1
view building 0:GACNST
cheat credits 50000
click tab:0
click cameo:GAPOWR
wait 60
shot h03_building_clock
until 900 queue_ready(structure) == 1
wait 2
shot h04_ready
assert queue_ready(structure) == 1
click cameo:GAPOWR
place auto
until 120 built(0,GAPOWR) == 1
click cameo:GAPILE
until 1200 queue_ready(structure) == 1
click cameo:GAPILE
place auto
until 300 built(0,GAPILE) == 1
click tab:2
click cameo:E1
click cameo:E1
click cameo:E1
click cameo:E1
wait 10
shot h05_queue_count
click cameo:E1 right
wait 3
shot h06_on_hold
move cameo:E1
wait 60
shot h07_cameo_hover
assert tooltip != ""
click building 0:GACNST
wait 3
shot h08_building_selected
click tab:0
move button:repair
wait 40
shot h09_repair_hover
end
