# Wave-5 R-080 / R-081: a Medium American AI builds its Airforce Command,
# trains Harriers for its "4 Harriers" / "2 Harriers" TaskForces and flies
# them on sorties; idle AI infantry garrison a nearby civilian building.
set render_every 3000
set on_quit continue
set max_frames 20000
click button "Single Player"
click button Skirmish
require scene == lobby
click combo:ai1
click "pick:Medium Enemy"
click combo:country1
click pick:America
click start
until 120 scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
cheat credits 50000
# A prism ring keeps the passive player alive while the AI builds up.
cheat place GAPOWR 0 building 0:GACNST -5 -4
cheat place GAPOWR 0 building 0:GACNST -5 -1
cheat place GAPOWR 0 building 0:GACNST -5 +2
cheat place GAPOWR 0 building 0:GACNST -5 +5
cheat place ATESLA 0 building 0:GACNST +5 -4
cheat place ATESLA 0 building 0:GACNST +5 +0
cheat place ATESLA 0 building 0:GACNST +5 +4
cheat place ATESLA 0 building 0:GACNST +0 +5
cheat place ATESLA 0 building 0:GACNST +0 -5
cheat place ATESLA 0 building 0:GACNST -8 +0
cheat place ATESLA 0 building 0:GACNST +3 +7
cheat place ATESLA 0 building 0:GACNST +3 -7
# Americans build their Airforce Command (AMRADR, Helipad=yes NumberOfDocks=4).
until 6000 buildings(1,AMRADR) >= 1 or buildings(1,GAAIRC) >= 1 @R-080:C
until 6000 ai_air_sorties >= 1 @R-080:C
until 3000 ai_garrisons >= 1 @R-081:C
shot ai_air
end
