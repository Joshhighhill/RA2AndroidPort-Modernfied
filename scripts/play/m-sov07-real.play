# P2: SOV07 (Chronosphere) won with real orders only (no cheats).
# Generated by scripts/play/gen/mk_sov07.py -- edit the generator, not this
# file. Flak Tracks + Apocalypse tanks + Tesla Coils hold the Battle Lab
# through every chrono wave; after the 2550 s 'Massive Last Attempt' the army
# hunts the last BadGuy1 units and 'PlayerWin1' -> 'PlayerWin2' -> VICTORY.
set render_every 6000
set on_quit continue
set max_frames 60000
set campaign sov07s.MAP Nod
until 60 scene == campaign-load
click start
until 300 scene == game
wait 30
until 1500 input_locked == 0
let n_NAPOWR = built(0,NAPOWR)
let tc_NAPOWR = f
until 900 can_build(NAPOWR) == 1 or f >= $tc_NAPOWR+899
let ok_NAPOWR = can_build(NAPOWR)
if $ok_NAPOWR == 1 then click tab:0
if $ok_NAPOWR == 1 then click cameo:NAPOWR
let tq_NAPOWR = f
until 2400 queue_ready(structure) == 1 or $ok_NAPOWR == 0 or f >= $tq_NAPOWR+2399
if queue_ready(structure) == 1 then click cameo:NAPOWR
if placing == 1 then place auto
let t_NAPOWR = f
until 600 built(0,NAPOWR) > $n_NAPOWR or $ok_NAPOWR == 0 or f >= $t_NAPOWR+599
