# ART-ALL10 -- W3-FIX-A art acceptance. ALL10 (SNOW, Black Forest): the 18 ammo crates (AMMOCRAT, ammo01.shp only in sno.mix) and the snow cottages.
set render_every 600
set on_quit continue
set campaign ALL10S.MAP GDI
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat art_dump
assert art.missing == 0
cheat view_building AMMOCRAT
wait 2
shot ammo
cheat view_building CAEUR1
wait 2
shot cottages
