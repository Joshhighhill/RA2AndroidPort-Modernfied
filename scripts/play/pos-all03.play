# POS-ALL03 -- W4-FIX-POS acceptance (docs/gap/wave4/01-positioning.md §3):
#   whitehouse  CAWASH01 4x4 (L4) inside its sandbag ring on the paved lot
#   monument / jefferson / lincoln  3x3 / 3x3 / 3x4 landmarks on their lots
#   sandbag     GASAND overlays (cell centre - 12) tracing the lot edges
#   gacnst      the player ConYard 4x4 + ActiveAnim, clear of the ore field;
#               ore centred in its own cells (cell centre - 12)
#   bases       player 2x2 (GAPOWR), 3x3 (GAOREP + ActiveAnim, GADEPT + bib),
#               4x3 (GAREFN + bib + lights), 2x2 voxel turret (GTGCAN)
#   wh2 / wh2_ruin  a second White House killed: its DestroyAnim ruin
#               (CAWS01DM, L4) lies exactly on the foundation (was 120 px low)
set render_every 600
set on_quit continue
set campaign ALL03U.MAP GDI
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat view_building CAWASH01
wait 2
shot whitehouse
cheat view_building CAWSH12
wait 2
shot monument
cheat view_building CAWASH14
wait 2
shot jefferson
cheat view_building CAWASH15
wait 2
shot lincoln
cheat view_key ovl:GASAND 0
wait 2
shot sandbag
cheat view_building GACNST
wait 2
shot gacnst
cheat building GAPOWR 86 126
cheat building GAOREP 86 121
cheat building GADEPT 90 125
cheat building GAREFN 90 120
cheat building GTGCAN 92 129
wait 30
cheat view_building GAOREP
wait 2
shot bases
cheat building CAWASH01 70 22
cheat view_building CAWASH01 1
wait 2
shot wh2
cheat damage_building 0:CAWASH01 100000
wait 120
shot wh2_ruin
