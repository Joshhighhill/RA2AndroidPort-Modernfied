# POS-ALL12 -- W4-FIX-POS acceptance: St Basil's (CARUS01 4x4) inside the
# Kremlin wall, the wall overlays meeting their 1x1 towers; the Kremlin
# (CARUS03 2x5) on its lot.
set render_every 600
set on_quit continue
set campaign ALL12S.MAP GDI
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat view_building CARUS01
wait 2
shot basils
cheat view_building CARUS03
wait 2
shot kremlin
