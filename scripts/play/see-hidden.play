# see-hidden -- W5-E2 (R-146): RA2.INI ShowHidden ("See Hidden Objects")
# shows the [AudioVisual] Behind= anim over an object a structure covers
# [RE: FUN_0070E600 / FUN_00423AE0, Options +0x1F].
set render_every 1
set on_quit continue
click button Options
click opt:check:hidden
assert opt_check(hidden) == 1
click button "Main Menu"
click button "Single Player"
click button Skirmish
click start
until 90 scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
cheat w2 build GAWEAP
wait 5
cheat spawn E1 0 building 0:GAWEAP +0 -1
cheat spawn E1 0 building 0:GAWEAP +1 -1
wait 3
view building 0:GAWEAP
wait 2
assert hidden_marked >= 1                                @R-146:E
shot sh01_behind_marker
end
