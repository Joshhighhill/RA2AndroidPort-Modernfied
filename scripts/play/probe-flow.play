# Harness self-check on the CURRENT master control model (left=select, right=order).
click button "Single Player"
click button Skirmish
click start
until 30 scene == game
view building 0:GACNST
shot base
click unit 0:E1
assert selected >= 1
let x0 = sel_cx
click unit 0:E1 +6 +0 right
wait 2
assert sel_moving == 1
until 300 sel_cx != $x0
click cameo:GAPOWR
until 3000 queue_ready(structure) == 1
click cameo:GAPOWR
assert placing == 1
place auto
until 600 built(0,GAPOWR) == 1
shot power
dump
end
