# ART-ALL07 -- W3-FIX-A acceptance: ALL07 (TEMPERATE, Hawaii). The player's
# own Naval Yard (GAYARD at 186,131, WaterBound) is placed on the water.
set render_every 600
set on_quit continue
set campaign ALL07T.MAP GDI
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat art_dump
assert art.missing == 0
assert bld.0.GAYARD >= 1
cheat view_building GAYARD
wait 2
shot shipyard
