# W8-BRIDGE-LOW-MAYDAY -- wave-8 low-bridge fixes on May Day (xmp31s2), the
# river span x 71..74, y 117..119 (shipped destroyed, repaired at the hut).
# [RE: CellClass::RecalcAttributes FUN_0047D1C0 -- LOBRDG Land=Road,
# NoUseTileLandType=true (loader 0x5FE148): the repaired cells over Water tiles
# are Road]
#  1. A Grizzly crosses at Road speed, not the Water row's 0% -> 0.5 fall-back
#     (W8-03-03).
#  2. An enemy tank on the span is not a naval target: a Typhoon
#     (LandTargeting=1) is refused (W8-04-01).
#  3. Tanya walks over it, no Swim set (W8-04-01 / W8-01-04).
#  4. The section collapses [RE: FUN_00487920]: three Conscripts in one cell
#     die (they cannot enter Water), Tanya survives (W8-03-07 / W8-01-03).
set render_every 0
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click button "Customize Battle"
click list:down
click list:down
click map:xmp31s2.map
click button "Use Map"
require map == "xmp31s2.map"
click check:crates
click combo:ai1
click "pick:Easy Enemy"
click slider:units=0
click start
until 90 scene == game
require scene == game
cheat credits 300000
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
wait 300
let d0 = bridge_destroyed
cheat spawn ENGINEER 0 point bridge_near -1 +0
wait 2
click unit 0:ENGINEER
click point hut
until 600 bridge_destroyed < $d0
# --- 1. own Grizzly speed across the repaired span ---------------------------------
cheat spawn MTNK 0 cell 66 118
wait 2
click unit 0:MTNK
wait 1
require selected == 1
click cell 80 118
until 600 ucell(0,MTNK,0) == 69118
let s_land = uspeed(0,MTNK,0)
until 600 ucell(0,MTNK,0) == 73118
assert uland(0,MTNK,0) == 1                        @W8-03-03
assert uspeed(0,MTNK,0) == $s_land                 @W8-03-03
until 600 ucell(0,MTNK,0) == 80118
cheat w2 kill 0:MTNK
wait 30
# --- 2. an enemy tank on the span over the Water tile ----------------------------
cheat spawn MTNK 1 cell 73 118
cheat spawn SUB 0 cell 73 123
wait 3
assert uland(1,MTNK,0) == 1                        @W8-04-01
require ucell(1,MTNK,0) == 73118
let t0 = uhpn(1,MTNK,0)
click unit 0:SUB
wait 1
require selected == 1
click unit 1:MTNK
wait 300
assert utgt(0,SUB,0) == -1                         @W8-04-01
assert uhpn(1,MTNK,0) == $t0                       @W8-04-01
cheat w2 kill 0:SUB
cheat w2 kill 1:MTNK
wait 30
# --- 3. Tanya walks across ---------------------------------------------------------
cheat spawn TANY 0 cell 66 118
wait 2
click unit 0:TANY
wait 1
require selected == 1
click cell 73 118
until 900 ucell(0,TANY,0) == 73118
wait 20
assert iseq(Swim) == 0                             @W8-04-01
assert iseq(Tread) == 0                            @W8-04-01
assert uland(0,TANY,0) == 1                        @W8-04-01
# --- 4. collapse: three Conscripts in one cell, Tanya on the next one --------------
cheat spawn E2 0 cell 73 117
cheat spawn E2 0 cell 73 117
cheat spawn E2 0 cell 73 117
wait 3
assert max_cell_inf(0) == 3
let e2 = units(0,E2)
dump
cheat bridge_hit 73 118 100000
wait 2
cheat bridge_hit 73 118 100000
wait 30
log AFTER_HIT
dump
assert units(0,E2) == 0                            @W8-03-07
assert units(0,TANY) == 1                          @W8-01-03
end
