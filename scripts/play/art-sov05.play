# ART-SOV05 -- W3-FIX-A art acceptance. SOV05 (URBAN, Paris): the Eiffel Tower (CAPARS01, the objective) and the Arc de Triomphe (CAPARS11) from isogen.mix.
set render_every 600
set on_quit continue
set campaign SOV05U.MAP Nod
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat art_dump
assert art.missing == 0
cheat view_building CAPARS01
wait 2
shot eiffel
cheat view_building CAPARS11
wait 2
shot arc
