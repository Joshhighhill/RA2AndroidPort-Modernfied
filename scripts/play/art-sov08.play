# ART-SOV08 -- W3-FIX-A art acceptance. SOV08 (URBAN, Washington DC): the White House (the target) and the Washington Monument / Lincoln / Jefferson memorials.
set render_every 600
set on_quit continue
set campaign SOV08U.MAP Nod
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 30
cheat reveal
cheat art_dump
assert art.missing == 0
cheat view_building CAWASH01
wait 2
shot whitehouse
cheat view_building CAWSH12
wait 2
shot monument
cheat view_building CAWASH15
wait 2
shot lincoln
