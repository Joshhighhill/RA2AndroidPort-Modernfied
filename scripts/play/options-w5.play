# options-w5 -- W5-E acceptance (R-146 / R-145 tick): Visual Details reaches
# the anim DetailLevel filter, the slider tick / volume preview sounds, and the
# desktop resolution combobox (RA2.INI [Video] + the window).
set render_every 300
set on_quit continue
click button Options
require scene == "shell:Options"
click opt:slider:scroll=2
assert why(slider_tick) >= 1                             @R-145:E
# (the volume sliders are disabled without a sound device -- EnableWindow
#  (audio_present), options.md §2 -- so the preview is not reachable in --play)
click opt:slider:visual=0
assert opt_pos(visual) == 0                              @R-146:E
click opt:res
assert opt_res_open == 1                                 @R-146:E
shot op01_res_open
click opt:res:1
wait 2
assert opt_res == "800 x 600 x 16"                       @R-146:E
shot op02_res_picked
click button "Main Menu"
end
