# w8fix-place W8-05-01 [RE: JumpjetLocomotionClass Descending FUN_0054C280
# @0x54C2AA; Stop_Moving FUN_0054B200; UnitClass Mission_Unload FUN_0073C560]:
# ALL01T, the east high bridge repaired. A Night Hawk ordered over open
# water or onto the deck over the river (the deck keeps the tile's Water
# LandType) HOVERS there; ordered onto free road it lands. Ordered onto a
# cliff face it re-targets the nearest hover-able cell (NearByLocation) --
# over water it then hovers. Loaded and told to unload over water it keeps hovering with its cargo.
set render_every 0
set on_quit continue
set campaign ALL01T.MAP GDI
click start
until 300 scene == game
until 60 input_locked == 1
until 1500 input_locked == 0
wait 5
cheat camp_killu 1 *
cheat camp_spawn ENGINEER 0 82 46
wait 3
click unit 0:ENGINEER
wait 1
click building 4:CABHUT
until 900 bridge_destroyed <= 4
cheat camp_spawn SHAD 0 81 45
wait 3
log water
cheat camp_move SHAD 78 52
wait 300
assert ucell(0,SHAD,0) == 78052
assert airborne(0) == 1
log deck-over-water
cheat camp_move SHAD 82 53
wait 300
assert ucell(0,SHAD,0) == 82053
assert airborne(0) == 1
log road
cheat camp_move SHAD 82 45
wait 300
assert ucell(0,SHAD,0) == 82045
assert airborne(0) == 0
log cliff-face
cheat camp_move SHAD 78 50
wait 400
assert ucell(0,SHAD,0) != 78050
log unload-over-water
cheat camp_spawn SHAD 0 79 44
cheat camp_spawn E1 0 80 44 2
wait 5
click unit 0:SHAD:1
wait 1
click xy 900 650 right nopark
wait 1
drag cell 80 43 81 45
wait 1
click unit 0:SHAD:1
waituntil 600 cargo_total(0) >= 2
require cargo_total(0) >= 1
click xy 900 650 right nopark
wait 1
click unit 0:SHAD:1
wait 1
click cell 78 53
wait 200
assert ucell(0,SHAD,1) == 78053
key d
wait 240
assert ucell(0,SHAD,1) == 78053
assert sel_cargo >= 1
assert sel_altitude > 0
end
