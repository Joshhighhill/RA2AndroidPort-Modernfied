# PRES-PARA -- W5-PRES R-122: paratroopers hang under the PARACH chute
# (opening, glide loop) and the chute collapses on landing.
set render_every 600
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click start
until 90 scene == game
require scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
# (an Iron-Curtained tank opens the World's air/naval step, which drops them)
cheat spawn MTNK 0 building 0:GACNST +3 +3
cheat pres_iron 0:MTNK:0
cheat pres_para E1 0 4 3 1600
cheat pres_para E1 0 5 4 1200
wait 30
shot para-open
wait 30
shot para-glide
until 400 units(0,E1) >= 0
wait 60
shot para-landing
wait 200
shot para-landed
end
