# SK-A -- playable core, human ALLIED vs 1 Soviet AI (Normal), stock MP map,
# $10000, crates off (ROADMAP-playable.md "core playthroughs"; GAP-ANALYSIS.md
# "Playable core"). Drives the REAL shell -> lobby -> GameScene.
#
# EXPECTED TO FAIL on master 63edea6. Every assertion carries @<G-ID>:<owner>;
# the expected failures are tabled in docs/gap/PLAYTEST-STATUS.md. Soft
# failures do not stop the run, so one run lists every broken step.
# Control model = the ORIGINAL one (left-click orders the selection, G-05).
set render_every 300
set on_quit continue

# --- lobby ------------------------------------------------------------------
click button "Single Player"
click button Skirmish
require scene == lobby
# Skirmish page (dialog 0x102): row 1 = Medium Enemy, Russia, Red; Crates off;
# Game Speed slider at 3 (the [Options] GameSpeed=3 pacing these steps were
# written against).
click combo:ai1
# W2-SK: Easy -- the Medium AI now fields full waves (W2-SK-06) that reach
# the base (W2-SK-05) and razed this scripted player's ConYard by min 6.
click "pick:Easy Enemy"
click combo:country1
click list:down
click list:down
click list:down
click pick:Russia
click combo:color1
click pick:RED
click check:crates
click slider:speed=3
assert side(0) == ALLIED
assert side(1) == SOVIET
assert ai(1) == Easy
assert check(crates) == 0
assert cash == 10000
click start
until 90 scene == game
require scene == game
shot start

# --- 1. start state -----------------------------------------------------------
assert credits == 10000                       @G-21:A
assert own_on_screen > 0                      @NEW-1:F
assert units(0,AMCV) == 1                     @G-23:F
assert buildings(0,GACNST) == 0               @G-23:F
assert sw(0) == 0                             @G-25:A

# --- 2. deploy the MCV (D) ---------------------------------------------------------
click unit 0:AMCV                             @G-23:F
key d                                         @G-23:F
until 450 built(0,GACNST) == 1                @G-23:F
view building 0:GACNST
shot base

# --- 3. select, move, stop (original model: left-click ground = move) -------------
click unit 0:E1
assert selected >= 1
click unit 0:E1 +5 +1                         @G-05:B
wait 3
assert selected >= 1 and sel_moving == 1     @G-05:B
key s                                         @G-04:B
# Stop finishes entering the cell already reserved (unit_orders.cpp); with
# the MCV start the GI may be mid-cell, so allow the hop to complete.
until 30 sel_moving == 0                      @G-04:B
assert selected >= 1 and sel_moving == 0     @G-04:B

# --- 4. base: power plant ---------------------------------------------------------
click tab:0
assert can_build(GAPOWR) == 1                 @G-23:F
click cameo:GAPOWR
until 900 queue_ready(structure) == 1
click cameo:GAPOWR
assert placing == 1
place auto
until 120 built(0,GAPOWR) == 1
assert power_out > 0
# Esc with nothing armed must not end the session; it opens the options menu,
# and Esc again resumes ([Hotkey] Options=27 -> FUN_00646AE0 -> dialog 0xB5).
key esc                                       @G-01:B
wait 2
assert quits == 0                             @G-01:B
assert menu_open == 1                         @G-01:B
key esc                                       @G-01:B
wait 2
assert menu_open == 0                         @G-01:B

# --- 5. refinery -> miner -> income (the economy firewall) ---------------------------
click tab:0
click cameo:GAREFN
until 1800 queue_ready(structure) == 1
click cameo:GAREFN
place auto
until 300 built(0,GAREFN) == 1
until 120 harvesters(0) >= 1
let c1 = credits
until 1800 harv(0,Harvesting) >= 1            @G-20:A
until 2700 credits > $c1                      @G-20:A
shot economy

# --- 6. barracks -> GI + Engineer -----------------------------------------------------
click tab:0
click cameo:GAPILE
until 900 queue_ready(structure) == 1
click cameo:GAPILE
place auto
until 300 built(0,GAPILE) == 1
click tab:2
assert cameo(ENGINEER) == 1                   @G-22:A
let gi0 = units(0,E1)
click cameo:E1
until 600 units(0,E1) > $gi0
click cameo:ENGINEER                          @G-22:A
until 900 units(0,ENGINEER) >= 1              @G-22:A

# --- 7. war factory -> Grizzly, Chrono Miner, MCV in the roster --------------------
click tab:0
click cameo:GAWEAP
until 1800 queue_ready(structure) == 1
click cameo:GAWEAP
place auto
until 300 built(0,GAWEAP) == 1
click tab:3
assert cameo(CMIN) == 1                       @G-22:A
# rulesmd [AMCV] Prerequisite=GAWEAP,GADEPT: the MCV needs a Service Depot.
click tab:0
click cameo:GADEPT                              @G-22:A
until 1800 queue_ready(structure) == 1        @G-22:A
click cameo:GADEPT                              @G-22:A
place auto                                    @G-22:A
until 300 built(0,GADEPT) == 1                  @G-22:A
click tab:3
assert cameo(AMCV) == 1                       @G-22:A
click cameo:MTNK
until 1500 units(0,MTNK) >= 1
# W2-GA-03: with FogOfWar off (the original's default, RE-Q3) the AI engages the
# player's miner in explored ground earlier, so the first Chrono Miner may be
# gone by now: check that one more is trained, not that two are alive.
# W2-SK: the vehicle factory holds one build at a time -- wait for the Grizzly
# to leave it before ordering the miner (the click was refused when the AI's
# changed pace made the tank still in production here).
until 1800 q.vehicle == -1
let cmin0 = units(0,CMIN)
let lost0 = units_lost(0)
click cameo:CMIN                              @G-22:A
until 1800 units(0,CMIN) > $cmin0 or units_lost(0) > $lost0   @G-22:A
until 1800 units(0,CMIN) >= 1                 @G-22:A

# --- 8. the AI plays: trains, attacks ----------------------------------------------
# W5-B: with three infantry per cell (R-061) the Easy AI's conscript squads
# arrive packed and raze the passive scripted player's refinery and barracks
# before this section's later steps need them; two Grizzlies stand guard by
# the refinery (a player would defend), and "the AI trains" also counts units
# it fielded and lost (our defenders now win the fights it starts).
# W6 (w6fix-ai): the AI now spreads its defences, earns its difficulty bonus
# and retaliates by anger, so its first wave may already have razed the
# refinery here -- guard the ConYard instead when the refinery is gone.
if buildings(0,GAREFN) >= 1 then cheat spawn MTNK 0 building 0:GAREFN +0 +3
if buildings(0,GAREFN) == 0 then cheat spawn MTNK 0 building 0:GACNST +0 +3
cheat spawn MTNK 0 building 0:GAPILE +2 +2
let u1 = units(1)
let l1 = units_lost(1)
let ul0 = units_lost(0)
let hl0 = hp_lost(0)
until 3000 units(1) > $u1 or units_lost(1) > $l1 @G-60:D
until 6000 units_lost(0) > $ul0 or hp_lost(0) > $hl0 @G-60:D
shot ai

# --- 9. every unit has a working weapon (Prism Tank: WeaponCount/Weapon1) -----------
assert weapon_damage(E1) > 0
assert weapon_damage(MTNK) > 0
# w7 (fv7a): the Easy AI's Rhinos now shell the passive base from weapon range
# (a human house's idle units answer no call for help, FUN_00707500), and the
# war factory may be gone by now -- spawn the Prism Tank by the ConYard then.
if buildings(0,GAWEAP) >= 1 then cheat spawn SREF 0 building 0:GAWEAP +4 +4
if buildings(0,GAWEAP) == 0 then cheat spawn SREF 0 building 0:GACNST +0 +4
wait 2
assert weapon_damage(SREF) > 0                @G-41:C
assert weapon_range(SREF) > 0                 @G-41:C

# --- 10. a Pillbox kills attackers ------------------------------------------------
click tab:1
click cameo:GAPILL
until 900 queue_ready(defense) == 1
click cameo:GAPILL
place auto
until 300 built(0,GAPILL) == 1
let ul1 = units_lost(1)
cheat spawn E2 1 building 0:GAPILL +3 +0
cheat spawn E2 1 building 0:GAPILL +3 +1
cheat spawn E2 1 building 0:GAPILL +4 +0
until 450 units_lost(1) >= $ul1+3           @G-40:C
shot defence

# --- 11. win path: the session ends with WON when the enemy is gone ----------------
cheat kill_house 1
until 60 world_outcome == WON
until 900 outcome == WON                      @G-02:F
shot won
end expect WON                                @G-02:F
