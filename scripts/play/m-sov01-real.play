# W5-A: SOV01 won with real orders only (no cheats). The high bridge 'Break
# Bridge' blows at f0 is repaired by an engineer the player trains (power plant,
# barracks) and walks -- escorted by the type-selected Conscripts -- to the
# revealed bridge hut (a real capture click). Then 25 more Conscripts walk round
# the American base's north edge to the Pentagon's east side and force-fire
# (Ctrl) the four sections; 'Win Condition 1' -> VICTORY. Generated by
# scripts/play/gen/mk_sov01.py -- edit the generator, not this file.
set render_every 3000
set on_quit continue
set campaign sov01t.MAP Nod
until 60 scene == campaign-load
click start
until 300 scene == game
until 60 bridge_destroyed >= 4
let broken = bridge_destroyed
until 2400 input_locked == 0
if units(0,SMCV) >= 1 then click unit 0:SMCV
if units(0,SMCV) >= 1 then key d
until 900 built(0,NACNST) >= 1
let n_NAPOWR = built(0,NAPOWR)
until 900 can_build(NAPOWR) == 1
click tab:0
click cameo:NAPOWR
until 2400 queue_ready(structure) == 1
click cameo:NAPOWR
place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
until 600 built(0,NAPOWR) > $n_NAPOWR
let n_NAHAND = built(0,NAHAND)
until 900 can_build(NAHAND) == 1
click tab:0
click cameo:NAHAND
until 2400 queue_ready(structure) == 1
click cameo:NAHAND
place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
until 600 built(0,NAHAND) > $n_NAHAND
until 900 cameo(SENGINEER) == 1
click tab:2
click cameo:SENGINEER
until 1200 units(0,SENGINEER) >= 1
if units(0,E2) > 0 then click unit 0:E2:0
if units(0,SENGINEER) > 0 then click unit 0:SENGINEER:0 shift
key t
key t
click cell 97 92
until 900 sel_moving == 0
wait 60
if units(0,E2) > 0 then click unit 0:E2:0
if units(0,SENGINEER) > 0 then click unit 0:SENGINEER:0 shift
key t
key t
click cell 99 95
until 1500 sel_moving == 0
wait 30
if units(0,SENGINEER) > 0 then click unit 0:SENGINEER:0
key t
key t
click cell 99 95
until 1500 sel_moving == 0
dump
click unit 0:SENGINEER:0
click building 4:CABHUT:1
wait 20
dump
until 1800 bridge_destroyed < $broken
assert units(0,SENGINEER) == 0
assert outcome == RUNNING
shot repaired
until 900 cameo(E2) == 1
click tab:2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
click cameo:E2
wait 1500
if units(0,E2) > 0 then click unit 0:E2:0
key t
key t
click cell 72 40
wait 30
until 2400 sel_moving == 0
wait 60
dump
