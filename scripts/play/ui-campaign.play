# W2-UI-18/19/21: Campaign select page 0x94 (wells, list, difficulty slider),
# the loading screen (auto start), objectives / briefing in game.fnt.
set on_quit continue
set render_every 300
click button "Single Player"
click button "New Campaign"
require scene == "shell:Campaign"
assert campaign_battle == ALL1
shot c01_campaign_page
move well:soviet
wait 2
shot c02_campaign_hover_soviet
click well:soviet
assert campaign_battle == SOV1
click campaign:0
assert campaign_battle == TUT1
click well:allied
assert campaign_battle == ALL1
click slider:difficulty=2
assert difficulty == 2
click slider:difficulty=0
assert difficulty == 0
shot c03_campaign_easy
click button Load
until 30 scene == campaign-load
assert difficulty == 0
shot c04_loading
until 300 scene == game
require scene == game
wait 600
shot c05_objectives
key f1
wait 2
shot c06_briefing
key f1
key esc
wait 2
assert menu_open == 1
click "menu:ABORT MISSION"
wait 2
assert confirm_open == 1
shot c07_abort_restart
click confirm:Restart
until 60 scene == campaign-load
end
