# fx-m-sov01 -- W3-FX trigger visuals, Soviet 1 (Red Dawn): the objective
# arrow (PlayAnimAt 479 = ARRWSE at the bridge hut, waypoint A), the burning
# building (PlayAnimAt 238 FLAMEGUY x2 + ParticleAnim 2 BigGreySmokeSys at
# AL), "Building 9" (ParticleAnim 12 = BigRedSmokeSys at AM), and the radar
# zoom squares of CreateRadarEvent. Forced with camp_fire.
set render_every 300
set on_quit continue
set campaign SOV01T.MAP Nod
until 60 scene == campaign-load
click start
until 400 scene == game
require scene == game
wait 15
cheat reveal
view cell 90 85
cheat camp_fire "Bridge Hut Anim"                   @W3-FX-41
wait 3
shot s01_arrow_bridge_hut                           @W3-FX-41
view cell 93 100
cheat camp_fire "Building 8"                        @W3-FX-41
wait 4
assert fx_systems >= 1                              @W3-FX-88
shot s02_flameguy_smoke                             @W3-FX-88
wait 60
shot s03_smoke_column                               @W3-FX-88
view cell 111 114
cheat camp_fire "Building 9"                        @W3-FX-88
wait 60
shot s04_red_smoke                                  @W3-FX-88
end
