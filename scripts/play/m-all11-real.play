place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
wait 1
if placing == 1 then place auto
until 600 built(0,GAWEAP) > $n_GAWEAP
click building 0:GAWEAP
wait 2
click cell 112 106
wait 2
click xy 900 650 right nopark
