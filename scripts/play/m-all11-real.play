# P1: ALL11 (Cuba) won with real orders only (no cheats).
# The map's three Chrono Miners harvest (P1 fix: Mission=Harvest). The player
# builds a war factory, Battle Lab and the Chronosphere ('Chronosphere is
# Built' reveals Cuba and hands the nuke silos to BadGuy2). IFVs, each
# carrying a Navy SEAL, gather in a block and are chronoshifted into the
# Tesla-free pocket of the silo compound; the SEALs get out and C4 the silos.
# All three silos fall -> 'Win (Nukes KIA)' -> VICTORY.
set render_every 3000
set on_quit continue
set campaign all11t.MAP GDI
until 60 scene == campaign-load
click start
until 300 scene == game
wait 30
until 3000 input_locked == 0
until 900 cameo(GHOST) == 1
click tab:2
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
click cameo:GHOST
let n_GAPOWR = built(0,GAPOWR)
until 900 can_build(GAPOWR) == 1
click tab:0
click cameo:GAPOWR
until 2400 queue_ready(structure) == 1
click cameo:GAPOWR
place auto
until 600 built(0,GAPOWR) > $n_GAPOWR
let n_GAWEAP = built(0,GAWEAP)
until 900 can_build(GAWEAP) == 1
click tab:0
click cameo:GAWEAP
until 2400 queue_ready(structure) == 1
click cameo:GAWEAP
place auto
until 600 built(0,GAWEAP) > $n_GAWEAP
let n_GAPOWR = built(0,GAPOWR)
until 900 can_build(GAPOWR) == 1
click tab:0
click cameo:GAPOWR
until 2400 queue_ready(structure) == 1
click cameo:GAPOWR
place auto
until 600 built(0,GAPOWR) > $n_GAPOWR
dump
until 900 cameo(FV) == 1
click tab:3
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
click cameo:FV
until 900 cameo(MTNK) == 1
click tab:3
click cameo:MTNK
click cameo:MTNK
let n_GATECH = built(0,GATECH)
until 900 can_build(GATECH) == 1
click tab:0
click cameo:GATECH
until 2400 queue_ready(structure) == 1
click cameo:GATECH
place auto
until 600 built(0,GATECH) > $n_GATECH
dump
until 900 can_build(GACSPH) == 1
click tab:1
click cameo:GACSPH
until 3000 queue_ready(defense) == 1
cycle cameo:GACSPH placing == 1
place auto
until 900 buildings(0,GACSPH) >= 1
dump
shot csph
until 3000 units(0,FV) >= 9 and units(0,GHOST) >= 9
dump
