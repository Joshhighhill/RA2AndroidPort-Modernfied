# Wave-7 fix (units): W7-01-05 a human's deployed GI shows NoMove and stays;
# W7-01-03 a new spy starts PermaDisguised; W7-01-01 a dog never latches onto
# a tank (NeverUse VirtualScanner); W7-01-13 P skips engineers.
set render_every 3000
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click combo:ai1
click "pick:Easy Enemy"
click slider:units=0
click slider:speed=2
click start
until 120 scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
cheat reveal
# ---- GI deploy: NoMove
cheat spawn E1 0 building 0:GACNST +4 +6
wait 2
let c0 = ucell(0,E1,0)
click unit 0:E1
key d
wait 20
move building 0:GACNST +8 +6
wait 1
assert cursor_name == nomove
click building 0:GACNST +8 +6
wait 60
assert ucell(0,E1,0) == $c0
# ---- spy: PermaDisguise at creation
cheat spawn SPY 0 building 0:GACNST +2 +8
wait 2
assert udisguised(0,SPY) == 1
# ---- dog vs tank: no latch
cheat spawn ADOG 0 building 0:GACNST +6 +10
cheat spawn HTNK 1 building 0:GACNST +7 +10
wait 90
assert parasited == 0
# ---- P: engineers are not combatants
cheat spawn ENGINEER 0 building 0:GACNST +3 +10
wait 2
key p
wait 2
assert selected_type(ENGINEER) == 0
end
