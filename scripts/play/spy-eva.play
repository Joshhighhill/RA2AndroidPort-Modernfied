# spy-eva -- W5-E2 (R-131): the BuildingInfiltrated* EVA lines [RE: spy
# infiltration FUN_004571E0]: the spy's owner hears EVA_BuildingInfiltrated /
# EVA_EnemyBasePoweredDown (power plant) / EVA_BuildingInfRadarSabotaged
# (radar) / EVA_NewTechnologyAcquired (Battle Lab).
set render_every 900
set on_quit continue
click button "Single Player"
click button Skirmish
require scene == lobby
click combo:ai1
click "pick:Easy Enemy"
click start
until 120 scene == game
click unit 0:AMCV
key d
until 450 built(0,GACNST) == 1
cheat place NAPOWR 1 building 0:GACNST -10 +6
cheat spawn SPY 0 building 0:GACNST -6 +5
wait 2
click unit 0:SPY
click building 1:NAPOWR
until 400 units(0,SPY) == 0
until 60 evareq(EVA_EnemyBasePoweredDown) >= 1           @R-131:E
assert evareq(EVA_BuildingInfiltrated) >= 1              @R-131:E
cheat place NARADR 1 building 0:GACNST -10 +12
cheat spawn SPY 0 building 1:NARADR -2 +0
wait 2
view building 1:NARADR
assert buildings(1,NARADR) == 1
click unit 0:SPY
click building 1:NARADR
wait 3
until 400 units(0,SPY) == 0
until 60 evareq(EVA_BuildingInfRadarSabotaged) >= 1          @R-131:E
end
