# Diagnostic: world-depth Part B only (bridges).
set render_every 300
set on_quit continue
set cycle_max 100
# ---------------------------------------------------------------- Part B
click button "Single Player"
click button Skirmish
require scene == lobby
cycle map:+ map == "xmp31s2.map"
require map == "xmp31s2.map"
click start
until 90 scene == game
require scene == game
assert bridge_cells > 0                       @G-49:G
let d0 = bridge_destroyed
require bridge_destroyed > 0

# Repair: an engineer enters the bridge repair hut (consumed) -> the blown
# span is whole again.
cheat spawn ENGINEER 0 point bridge_near -1 +0
wait 2
click unit 0:ENGINEER
click point hut                               @G-49:G
until 600 bridge_destroyed < $d0              @G-49:G
assert units(0,ENGINEER) == 0                 @G-49:G
view point bridge
shot repaired

# Drive across: a Grizzly on the near bank crosses to the far bank over it.
cheat spawn MTNK 0 point bridge_near +0 +0
wait 2
click unit 0:MTNK
click point bridge_far                        @G-49:G
until 600 on_bridge(0) >= 1                   @G-49:G
shot on-bridge
until 900 sel_dist_bridge_far <= 1            @G-49:G

# Destroy: back on the near bank, force-fire (Ctrl) the first section until
# it collapses (Random(1, BridgeStrength) < damage per shell, two stages).
click point bridge_near                       @G-49:G
until 900 sel_dist_bridge_near <= 1
let d1 = bridge_destroyed
click point bridge +0 +2 ctrl
wait 3
dump
wait 300
dump
end
