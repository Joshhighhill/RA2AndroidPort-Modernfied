// W6-06-02: the Windows version resource of ra2engine.exe / ra2game.exe
// (Explorer > Properties > Details). Generated by CMake from VERSION and the
// git commit (cmake/ra2_sources.cmake). No icon yet: the app name and icon
// are user decision U-2 (docs/gap/wave6/06-shell-release.md).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @RA2_VER_MAJOR@,@RA2_VER_MINOR@,@RA2_VER_PATCH@,0
 PRODUCTVERSION  @RA2_VER_MAJOR@,@RA2_VER_MINOR@,@RA2_VER_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RA2 Engine project"
            VALUE "FileDescription",  "RA2 Engine (plays Red Alert 2 with your own game files)"
            VALUE "FileVersion",      "@RA2_VERSION@"
            VALUE "InternalName",     "ra2engine"
            VALUE "LegalCopyright",   "See LICENSE and THIRD_PARTY_NOTICES.md. Not affiliated with Electronic Arts."
            VALUE "OriginalFilename", "ra2engine.exe"
            VALUE "ProductName",      "RA2 Engine"
            VALUE "ProductVersion",   "@RA2_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
